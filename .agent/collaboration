import { supabase } from '@/integrations/supabase/client';

export const teamService = {
  // Get team members
  async getTeamMembers(labId: string) {
    const { data, error } = await supabase
      .from('team_members')
      .select('*')
      .eq('lab_id', labId)
      .order('display_name');

    return { data, error };
  },

  // Invite team member
  async inviteMember(email: string, role: string, labId: string) {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) throw new Error('Not authenticated');

    const token = crypto.randomUUID();

    const { data, error } = await supabase
      .from('team_invitations')
      .insert({
        email,
        role,
        lab_id: labId,
        invited_by: user.id,
        token
      })
      .select()
      .single();

    if (!error && data) {
      // Send invitation email (via Edge Function or external service)
      await supabase.functions.invoke('send-team-invitation', {
        body: { email, token, invitedBy: user.email }
      });
    }

    return { data, error };
  },

  // Update member status (online/offline/away)
  async updateStatus(status: string) {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const { error } = await supabase
      .from('team_members')
      .update({ status, last_active: new Date().toISOString() })
      .eq('user_id', user.id);

    return { error };
  },

  // Update member presence (heartbeat every 30s)
  async updatePresence() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const { error } = await supabase
      .from('team_members')
      .update({ last_active: new Date().toISOString() })
      .eq('user_id', user.id);

    return { error };
  }
};


