# Docker ignore file for LabIQ
# Optimizes Docker build context

# Dependencies
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
dist/
build/
.next/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Tests
coverage/
*.test.ts
*.spec.ts

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Documentation (not needed in container)
docs/
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml

# Supabase (migrations run separately)
supabase/config.toml
supabase/.branches/
supabase/.temp/

# ML models (too large, download at runtime)
*.pkl
*.h5
*.onnx
models/

# Python
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
